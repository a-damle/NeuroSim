{
    "matrix_size": 128,
    "cond_number": 1e4,
    "max_outer": 20,
    "inner_iters": 30,
    "tol": 1e-10,
    "seed": 42,
    "row_parallelism": [128],
    "K_values": [1, 4, 8],

    "device_params": {
        "rram": {
            "mem_type": "resistive",
            "off_state": 2.5e-5,
            "on_state": 3.33e-4,
            "on_off_ratio": 13,
            "mem_states_file": "mem_states_rram.csv",
            "read_noise": 0.05,
            "output_noise": 0.28,
            "rate_stuck_0": 0.0,
            "rate_stuck_1": 0.0
        },
        "sram": {
            "mem_type": "resistive",
            "off_state": 1e-15,
            "on_state": 1e-14,
            "on_off_ratio": 10,
            "mem_states_file": "mem_states_sram.csv",
            "read_noise": 0.01,
            "output_noise": 0.26,
            "rate_stuck_0": 0.0,
            "rate_stuck_1": 0.0
        }
    },

    "sweep_configs": {
        "1": {
            "name": "Diag dominant",
            "precond": "diag",
            "w_bits": [8],
            "i_bits": [8]
        },
        "2": {
            "name": "Log-uniform σ, +λ",
            "precond": "diag",
            "w_bits": [16],
            "i_bits": [16]
        },
        "3": {
            "name": "Clustered σ, +λ",
            "precond": "diag",
            "w_bits": [16],
            "i_bits": [16]
        },
        "5": {
            "name": "Arithmetic σ, +λ",
            "precond": "diag",
            "w_bits": [12],
            "i_bits": [16]
        }
    }
}
